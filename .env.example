DATABASE_URL=postgres://recovery_app:recovery_dev@localhost:5434/recovery
ADMIN_DATABASE_URL=postgres://recovery:recovery_dev@localhost:5434/recovery
REDIS_URL=redis://localhost:6381

NODE_ENV=development
PORT=3000
HOST=localhost
PUBLIC_URL=http://localhost:5173

# 32 random bytes, base64. Encrypts users' Razorpay keys at rest: openssl rand -base64 32
VAULT_KEY=
# Signs OTP codes: openssl rand -hex 24
SESSION_SECRET=

# Sign-in codes are emailed through Resend. Unset in development, codes print to the server console.
RESEND_API_KEY=
MAIL_FROM=Recovery OPS <onboarding@resend.dev>
OTP_REQUESTS_PER_HOUR=20

OPENROUTER_API_KEY=
AGENT_MODEL=minimax/minimax-m3:free
GOOGLE_GENERATIVE_AI_API_KEY=

AGENT_TIMEOUT_MS=90000
AGENT_STEP_BUDGET=6
AGENT_USER_CAP_USD=0.10
AGENT_USD_PER_M_INPUT=1.5
AGENT_USD_PER_M_OUTPUT=7.5
MAX_CASES_PER_USER=25
